# Server Configuration
NODE_ENV=development

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=4000
AUTH_SERVICE_PORT=5001
NOTIFICATION_SERVICE_PORT=5002

# JWT Authentication Configuration
JWT_SECRET=your_jwt_secret_key_here

# API Versioning Configuration
API_PREFIX=/api
API_VERSION=v1

# Redis Cache & Rate Limiting Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# Auth Service Proxy Configuration
AUTH_SERVICE_URL=http://auth-service:5001
AUTH_ROUTE_PREFIX=/auth

# User / Notification Service Proxy Configuration
USER_SERVICE_URL=http://notification-service:5002
USER_ROUTE_PREFIX=/users

# Course Service Proxy Configuration
COURSE_SERVICE_URL=http://course-service:5003
COURSE_ROUTE_PREFIX=/courses
