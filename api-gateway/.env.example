NODE_ENV=production
GATEWAY_PORT=4000
GATEWAY_HOST=0.0.0.0
API_PREFIX=/api
API_VERSION=v1

# Gateway Runtime
LOG_LEVEL=info
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
TRUST_PROXY=false
CORS_ORIGINS=*
PROXY_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000
AUTH_SERVICE_URL=http://auth-service:5001
AUTH_ROUTE_PREFIX=/auth
USER_SERVICE_URL=http://user-service:5004
USER_ROUTE_PREFIX=/users
COURSE_SERVICE_URL=http://course-service:5003
COURSE_ROUTE_PREFIX=/courses
NOTIFICATION_SERVICE_URL=http://notification-service:5002
NOTIFICATION_ROUTE_PREFIX=/notifications
ENROLLMENT_SERVICE_URL=http://enrollment-service:5005
ENROLLMENT_ROUTE_PREFIX=/enrollments
PAYMENT_SERVICE_URL=http://payment-service:5006
PAYMENT_ROUTE_PREFIX=/payments
PROGRESS_SERVICE_URL=http://progress-service:5007
PROGRESS_ROUTE_PREFIX=/progress
ASSESSMENT_SERVICE_URL=http://assessment-service:5008
ASSESSMENT_ROUTE_PREFIX=/assessments
CERTIFICATE_SERVICE_URL=http://certificate-service:5009
CERTIFICATE_ROUTE_PREFIX=/certificates

